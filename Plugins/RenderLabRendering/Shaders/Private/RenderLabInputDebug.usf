#include "/Engine/Private/Common.ush"
#include "/Engine/Private/ScreenPass.ush"
#include "/Plugin/RenderLabRendering/Private/RenderLabCommon.ush"

Texture2D SceneDepthTexture;

SCREEN_PASS_TEXTURE_VIEWPORT(InputViewport)


// 找到 SceneColor 当前这个位置，在 SceneDepth 中对应的是哪个像素
float4 MainPS(noperspective float4 UVAndScreenPos : TEXCOORD0) : SV_Target0 {
	float2 TextureUV = UVAndScreenPos.xy;
	// 把整张 Texture 的 UV 坐标，转换为当前 Viewport 内部的局部 UV 坐标
	float2 ViewportUV = (TextureUV - InputViewport_UVViewportMin) * InputViewport_UVViewportSizeInverse;

	uint2 DepthViewMin  = View.ViewRectMinAndSize.xy;	// 起点
	uint2 DepthViewSize = View.ViewRectMinAndSize.zw;	// 视图尺寸
	uint DepthWidth;
	uint DepthHeight;
	SceneDepthTexture.GetDimensions(DepthWidth, DepthHeight); // 有效区域的宽高

	// 调试保护：视图范围必须落在实际深度纹理内。
	if (any(DepthViewSize == uint2(0, 0)) ||
		any(DepthViewMin + DepthViewSize > uint2(DepthWidth, DepthHeight)))
	{
		return float4(1, 0, 1, 1);
	}

	// viewport UV -> DepthPixel
	int2 DepthPixel = int2(DepthViewMin) + int2(floor(ViewportUV * float2(DepthViewSize)));

	// 位置和深度重建
	float3 Position;
	float LinearDepth;
	if (!TryLoadPosition(SceneDepthTexture, DepthPixel, Position, LinearDepth))
	{
		return float4(0, 0, 0, 1);
	}

	// 位置输出
	// return float4(frac(Position / 500), 1.0);

	// 深度输出
	// float DisplayDepth = saturate(LinearDepth / 5000.0);
	// return float4(DisplayDepth.xxx, 1.0);

	// 重构空间法线
	float3 Normal;
	if (!TryReconstructNormal(SceneDepthTexture, DepthPixel, Normal))
	{
		return float4(0, 0, 0, 1);
	}

	// 法线输出
	return float4(Normal * 0.5 + 0.5, 1.0);
}

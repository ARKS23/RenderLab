#include "/Engine/Private/Common.ush"

Texture2D InputTexture;
SamplerState InputSampler;
float Strength;

float4 MainPS(noperspective float4 UVAndScreenPos : TEXCOORD0) : SV_Target0
{
    float4 color = Texture2DSample(InputTexture, InputSampler, UVAndScreenPos.xy);
    float gray = dot(color.rgb, float3(0.2126f, 0.7152f, 0.0722f));
    float3 result = lerp(color.rgb, float3(gray, gray, gray), saturate(Strength));
    return float4(result, color.a);
}